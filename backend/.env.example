DATABASE_URL=postgresql+psycopg://library:library@localhost:5432/library
# Opcional: `python -m scripts.seed_dev_data` só popula o banco se SEED_DEV_DATA=1 (o docker-compose da API já define isso).
# SEED_DEV_DATA=1
LOG_FORMAT=json

# API + Celery worker: cache / invalidação (índice 0). Worker precisa do mesmo host que a API em Docker (ex.: redis:6379).
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_BOOK_SECONDS=60
CACHE_TTL_BOOK_LIST_SECONDS=30

JWT_SECRET_KEY=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CELERY_BROKER_URL=redis://localhost:6379/1
LOAN_REMINDER_WEBHOOK_URL=
WEBHOOK_TIMEOUT_SECONDS=10

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=LaBiblioteca <noreply@labiblioteca.com>
SMTP_USE_TLS=true